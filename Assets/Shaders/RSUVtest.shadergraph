        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "GetColor",
    "m_FunctionSource": "2a8f0f893e5be6749829fa500e2577e1",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "uint c = unity_RendererUserValue;\r\nfloat4 testothername = float4((float)((c >> 0) & 255) * (1.f / 255.f),\r\n                        (float)((c >> 8) & 255) * (1.f / 255.f),\r\n                        (float)((c >> 16) & 255) * (1.f / 255.f),\r\n                        (float)1.f);\r\n"
}

